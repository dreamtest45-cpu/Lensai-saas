# Copy this file to .env.local for local development, and set the same
# names/values in Vercel → Project Settings → Environment Variables for
# production. See README.md for full setup steps for each service.

# ---- Supabase --------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — never expose to the browser / never prefix with NEXT_PUBLIC_.
# Bypasses Row Level Security. Server-side only (lib/supabase/server.ts).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Gemini ------------------------------------------------------------
# https://aistudio.google.com/apikey
# SECRET — used only server-side in app/api/generate, never sent to the browser.
GEMINI_API_KEY=

# ---- MEPS / PayTabs Jordan ---------------------------------------------
# From your PayTabs dashboard → "مفاتيح الربط" (Integration keys).
MEPS_PROFILE_ID=
# SECRET — the SERVER key ("مفتاح الخادم"), not the client key. Used both
# to authorise API calls to PayTabs and to verify the HMAC signature on
# incoming webhook callbacks (lib/meps.ts). Never expose to the browser.
MEPS_SERVER_KEY=

# ---- Cron protection -----------------------------------------------------
# Any long random string (e.g. `openssl rand -hex 32`). Vercel Cron sends
# this automatically as `Authorization: Bearer <value>` when calling
# /api/cron/downgrade-expired — set the SAME value here and in Vercel's env
# vars so the cron route can tell a real scheduled run from a random request.
CRON_SECRET=

# ---- Site URL ------------------------------------------------------------
# Your deployed site's real URL in production (used to build MEPS
# callback/return URLs and auth redirect links). Use http://localhost:3000
# for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
